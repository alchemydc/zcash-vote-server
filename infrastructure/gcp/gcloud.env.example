# GCP Configuration for zcash-vote-server validator deployment
# Copy this file to gcloud.env and fill in your values
# Then run: source gcloud.env before running terraform/tofu commands

# ===================
# Bootstrap Variables
# ===================
# These are used by bootstrap.sh to set up the project

# Your GCP project ID (for existing project) OR new project ID (for --create-project)
export TF_VAR_project_id="your-gcp-project-id"

# For NEW project creation only (--create-project flag):
# Organization ID (get with: gcloud organizations list --format="value(ID)")
# export TF_VAR_org_id="YOUR_ORG_ID"
# Billing account (get with: gcloud billing accounts list --format="value(name)")
# export TF_VAR_billing_account="YOUR_BILLING_ACCOUNT_ID"

# GCP region and zone
export TF_VAR_region="us-central1"
export TF_VAR_zone="us-central1-a"

# ===================
# Validator Variables
# ===================
# These are used when deploying validators

# Unique name for this validator (e.g., validator-01, validator-alice)
export TF_VAR_validator_name="validator-01"

# Your SSH public key for access to the instance
# Get your key with: cat ~/.ssh/id_rsa.pub
export TF_VAR_admin_ssh_key="ssh-rsa AAAAB3NzaC1yc2E... your-email@example.com"

# Your IP address(es) allowed to SSH (use your current IP or ranges)
# Get your IP with: curl -s ifconfig.me
export TF_VAR_admin_ip_ranges='["0.0.0.0/0"]'

# Toggle to allow direct remote SSH (default: false). When true, Terraform will create an SSH firewall
# rule (restricted by TF_VAR_admin_ip_ranges) and the instance startup will run install-security.sh.
# Default is false to require `gcloud compute ssh` for access.
export TF_VAR_remote_ssh_enabled=false

# Note: IAP TCP forwarding requires a firewall rule allowing SSH from Google's IAP proxy IP range.
# We create a firewall rule to allow SSH only from the IAP CIDR (35.235.240.0/20) so that:
# - gcloud compute ssh --tunnel-through-iap works
# - direct SSH from the internet remains blocked unless TF_VAR_remote_ssh_enabled=true

# ===================
# Optional Variables
# ===================

# Environment name
export TF_VAR_environment="production"

# Compute configuration
export TF_VAR_machine_type="e2-standard-2"
export TF_VAR_boot_disk_size_gb=100

# Network configuration
export TF_VAR_network_name="default"
export TF_VAR_subnet_name="default"
export TF_VAR_enable_external_ip=true

# API access (default: internal only for security)
export TF_VAR_enable_api_public_access=false
# If enabling public access, specify allowed IP ranges:
# export TF_VAR_api_allowed_ip_ranges='["1.2.3.4/32"]'

# Monitoring and logging (requires IAM permissions - see bootstrap.sh)
export TF_VAR_enable_cloud_monitoring=true
export TF_VAR_enable_cloud_logging=true

# Backups
export TF_VAR_enable_snapshots=true
export TF_VAR_snapshot_schedule="daily"

# Software versions
export TF_VAR_cometbft_version="v0.38.0"
export TF_VAR_vote_server_repo="https://github.com/alchemydc/zcash-vote-server"
export TF_VAR_vote_server_branch="dev"

# Labels for resource organization
# IMPORTANT: Label values must be lowercase letters, numbers, underscores, and dashes only
# Maximum 63 characters per value
export TF_VAR_labels='{
  "managed_by": "opentofu",
  "component": "zcash-vote-server",
  "team": "zf"
}'

# ===================
# Auto-Generated
# ===================
# The following line is added by bootstrap.sh
# It generates a new short-lived access token each time gcloud.env is sourced
# export GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token --impersonate-service-account terraform@${TF_VAR_project_id}.iam.gserviceaccount.com)

# ===================
# Usage Notes
# ===================
# 1. First time setup:
#    ./bootstrap.sh [--create-project] [--with-state-bucket]
#
# 2. Before each deployment:
#    source gcloud.env
#
# 3. Deploy validator:
#    tofu plan
#    tofu apply
#
# 4. Get validator's P2P address after deployment:
#    tofu output cometbft_p2p_address
