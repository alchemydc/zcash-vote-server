# GCP Configuration for zcash-vote-server validator deployment
# Copy this file to gcloud.env and fill in values, then run:
#   source gcloud.env
# before running terraform/tofu commands.
#
# Sections are ordered: required core -> bootstrap-for-new-project -> validator -> software versions
# -> compute -> network & security -> overlay (Tailscale) -> observability -> backups -> labels -> usage.

# ================================
# REQUIRED - Core GCP settings
# ================================
# Project ID for existing project (or new project id if creating a project)
export TF_VAR_project_id="your-gcp-project-id"

# Region and zone for resources
export TF_VAR_region="us-central1"
export TF_VAR_zone="us-central1-a"

# ================================
# REQUIRED IF CREATING A NEW GCP PROJECT
# (Used by bootstrap.sh --create-project)
# Keep commented unless you are creating a new project.
# ================================
# Organization ID (gcloud organizations list --format="value(ID)")
# export TF_VAR_org_id="YOUR_ORG_ID"

# Billing account (gcloud beta billing accounts list --format="value(name"))
# export TF_VAR_billing_account="YOUR_BILLING_ACCOUNT_ID"

# ================================
# REQUIRED - Validator / Access
# ================================
# Unique name for this validator (e.g., validator-01)
export TF_VAR_validator_name="validator-01"

# Admin SSH public key (for direct SSH when enabled.  not required if using `gcloud compute ssh --tunnel-through-iap`)
# Get with: cat ~/.ssh/id_rsa.pub
export TF_VAR_admin_ssh_key="ssh-rsa AAAAB3NzaC1yc2E... your-email@example.com"

# Allowlist of IP CIDR ranges allowed to SSH when remote SSH is enabled
# Example: '["203.0.113.45/32"]'
export TF_VAR_admin_ip_ranges='["0.0.0.0/0"]'

# Toggle direct remote SSH (creates SSH firewall if true). Default: false
# If false, use: gcloud compute ssh <instance> --tunnel-through-iap
export TF_VAR_remote_ssh_enabled=false

# ================================
# REQUIRED - Software versions
# ================================
# CometBFT version to install
export TF_VAR_cometbft_version="v0.38.0"

# zcash-vote-server repository and branch
export TF_VAR_vote_server_repo="https://github.com/alchemydc/zcash-vote-server"
export TF_VAR_vote_server_branch="main"

# ================================
# Compute resources
# ================================
# Machine type (single authoritative definition)
export TF_VAR_machine_type="e2-standard-2"
# upgrade options include e2-standard-4, n2-standard-4, c3-highcpu-8
#e2-standard-4: 4 vCPU / 16GB RAM. Cheap bump, ~1.7–2x faster than e2-standard-2.
#e2-highcpu-8: 8 vCPU / 8GB RAM. Good for parallel rustc tasks; watch memory for large builds.
#n2-standard-4: Newer Intel, better single-core; modest uplift vs e2.
#c3-standard-4: Next-gen (Intel Sapphire Rapids) + Tier 1 networking; faster per-core compile.
#c3-highcpu-8: 8 vCPU / 8GB; high bang-for-buck for short compile bursts.
#c3-highcpu-16: If doing repeated full clean builds; beyond this diminishing returns unless very large crate graph.

# Boot disk size in GB
export TF_VAR_boot_disk_size_gb=100

# Environment label
export TF_VAR_environment="production"

# ================================
# Network & Security (grouped)
# ================================
# Whether to assign a public external IP to the instance
# this will be necessary if not using the overlay network for p2p comms
export TF_VAR_enable_external_ip=true

# Whether to expose the API publicly (port 8000). Default: false
export TF_VAR_enable_api_public_access=false
# If enabling public API, restrict ranges:
# export TF_VAR_api_allowed_ip_ranges='["1.2.3.4/32"]'

# CometBFT P2P port (local port used by peers). Default: 26656
export TF_VAR_cometbft_p2p_port=26656

# VPC network and subnet names
export TF_VAR_network_name="default"
export TF_VAR_subnet_name="default"

# ================================
# Optional overlay: Tailscale (encrypted P2P, disables public P2P firewall)
# ================================
# When enabled, CometBFT P2P traffic will be routed over Tailscale and the public P2P firewall
# rule WILL NOT be created. Store auth keys in Secret Manager for safety; do NOT commit keys.
export TF_VAR_enable_tailscale=false

# Provide a Tailscale auth key (prefer secret manager; leave empty here)
export TF_VAR_tailscale_auth_key=""

# Optional: tailnet name (informational)
export TF_VAR_tailscale_tailnet=""

# Advertise tags (ACL tags). Default: empty list (opt-in).
# To enable tags: export TF_VAR_tailscale_advertise_tags='["tag:validator"]'
# To disable tags explicitly: export TF_VAR_tailscale_advertise_tags='[]'
export TF_VAR_tailscale_advertise_tags='[]'

# ================================
# Observability
# ================================
# Enable Cloud Monitoring (requires permissions configured by bootstrap)
export TF_VAR_enable_cloud_monitoring=true

# Enable Cloud Logging (Ops agent)
export TF_VAR_enable_cloud_logging=true

# ================================
# Backups
# ================================
export TF_VAR_enable_snapshots=true
export TF_VAR_snapshot_schedule="daily"   # e.g., daily | weekly

# ================================
# Labels (resource organization)
# Values must be lowercase, numbers, underscores or dashes. Max 63 chars per value.
# ================================
export TF_VAR_labels='{
  "managed_by": "opentofu",
  "component": "zcash-vote-server",
  "team": "team zcash"
}'

# ================================
# Auto-generated (do not edit)
# This line will be appended by bootstrap.sh when sourcing gcloud.env
# it will make short lived access tokens work with terraform/opentofu
# export GOOGLE_OAUTH_ACCESS_TOKEN=$(gcloud auth print-access-token --impersonate-service-account terraform@${TF_VAR_project_id}.iam.gserviceaccount.com)
# ================================

# ================================
# Usage Notes
# ================================
# 1. First time setup (create project or bootstrap):
#    ./bootstrap.sh [--create-project] [--with-state-bucket]
#
# 2. Before each deployment:
#    source gcloud.env
#
# 3. Deploy validator:
#    tofu plan
#    tofu apply
#
# 4. After deployment:
#    tofu output cometbft_p2p_address
#
# Security reminders:
# - Do NOT commit your gcloud.env (contains sensitive values).
# - Prefer Secret Manager for Tailscale auth keys and other secrets.
